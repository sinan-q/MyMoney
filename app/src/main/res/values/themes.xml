<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyMoney" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- New icon as splash screen icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- Matching "Warm Ivory" background -->
        <item name="windowSplashScreenBackground">#FDFCF0</item>
        <!-- The theme to switch to after the splash screen is done -->
        <item name="postSplashScreenTheme">@style/Theme.MyMoney</item>
    </style>
</resources>